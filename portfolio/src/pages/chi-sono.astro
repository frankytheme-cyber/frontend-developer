---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Contact from "@/components/Contact.astro";

const siteUrl = "https://simonepuliti.dev";
const pagePath = "/chi-sono";
const title = "Chi sono — Simone Puliti, Web Designer & Sviluppatore a Verona";
const description =
  "Simone Puliti: web designer e frontend developer freelance a Verona con 14 anni di esperienza tra WordPress, React/Next.js e tool AI.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Chi sono", item: `${siteUrl}${pagePath}` },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={pagePath} jsonLd={jsonLd}>
  <main class="relative min-h-screen" data-template="about-page">
    <Nav />
    <div class="relative z-10">
      <section class="px-6 pt-32 pb-16 max-w-3xl mx-auto">
        <nav class="text-xs mb-8" style="color:var(--muted-2);font-family:var(--font-mono)" aria-label="Breadcrumb">
          <a href="/" class="hover:underline" style="color:var(--muted)">Home</a>
          <span class="mx-2">/</span>
          <span style="color:var(--text)">Chi sono</span>
        </nav>

        <h1 class="text-[clamp(2.5rem,6.5vw,4.5rem)] font-black leading-[0.95] tracking-[-0.03em] mb-8" style="color:var(--text)">
          Chi sono<span style="color:var(--accent-2)">.</span>
        </h1>

        <div class="prose-blog">
          <p>
            Sono <strong style="color:var(--text)">Simone Puliti</strong>, web designer e frontend developer freelance con oltre
            14 anni di esperienza. Lavoro da Verona per aziende, professionisti e startup in tutta Italia, principalmente da remoto.
          </p>
          <p>
            Il mio percorso parte dal web design e dallo sviluppo WordPress, e negli ultimi anni si è esteso ad app React/Next.js
            e all'integrazione di tool AI su misura (Claude API, OpenAI API) nei flussi di lavoro aziendali.
          </p>
          <p>
            Attualmente sviluppo frontend presso Fornace Srl, affiancando progetti freelance per clienti diretti: siti
            istituzionali, e-commerce WooCommerce, dashboard fintech e assistenti AI personalizzati.
          </p>
          <p><em>Contenuto di base in attesa del copy definitivo da SEO & GEO.</em></p>
        </div>

        <a
          href="/contatti"
          class="hover-opacity inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold mt-8"
          style="background:#171412;color:#fff;border-radius:2px;border:1px solid #2a2724"
        >
          Parliamo del tuo progetto
        </a>
      </section>

      <Contact />
    </div>
  </main>
</BaseLayout>
