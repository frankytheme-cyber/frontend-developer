---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import ProjectsCrypto from "@/components/ProjectsCrypto.astro";
import Contact from "@/components/Contact.astro";

const siteUrl = "https://simonepuliti.dev";
const pagePath = "/progetti/dashboard-fintech";
const title = "Progetti Dashboard & Fintech — Tool DeFi e Crypto | Simone Puliti";
const description =
  "Portfolio dashboard e tool fintech/crypto: analisi DeFi, simulatori di order book e strumenti di portafoglio sviluppati con React e TypeScript.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Dashboard & Fintech", item: `${siteUrl}${pagePath}` },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={pagePath} jsonLd={jsonLd}>
  <main class="relative min-h-screen" data-template="projects-page">
    <Nav />
    <div class="relative z-10">
      <div class="pt-14" />
      <ProjectsCrypto headingLevel="h1" />
      <Contact />
    </div>
  </main>
</BaseLayout>
