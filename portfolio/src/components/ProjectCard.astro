---
import { Image } from "astro:assets";
import arrowIcon from "lucide-static/icons/arrow-up-right.svg?raw";

// Non è nella libreria di icone generiche lucide-static (solo loghi brand): SVG inline.
const githubIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.16.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.62 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17.91-.25 1.89-.38 2.86-.38.97 0 1.95.13 2.86.38 2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.65 5.33-5.18 5.61.41.35.77 1.04.77 2.11 0 1.52-.01 2.75-.01 3.12 0 .3.2.65.79.54a10.77 10.77 0 0 0 7.76-10.77C23.25 5.48 18.27.5 12 .5Z"/></svg>`;

type Props = {
  name: string;
  description: string;
  tech: string[];
  liveUrl?: string;
  repoUrl?: string;
  image?: string;
  index?: number;
};

const { name, description, tech, liveUrl, repoUrl, image, index = 0 } = Astro.props;
---

<article
  data-reveal
  data-pattern="project-card"
  class="flex flex-col gap-4 overflow-hidden"
  style={`--d:${(index * 0.06).toFixed(2)}s;background:var(--surface);border-radius:12px;border:1px solid #ffffff1a`}
>
  {image && (
    <a href={liveUrl || repoUrl || "#"} target="_blank" rel="noopener noreferrer" class="hover-card-scale relative block overflow-hidden h-60 cursor-pointer">
      {image.startsWith("/") ? (
        <img
          src={image}
          alt={`${name} — ${tech.slice(0, 2).join(", ")} | Simone Puliti`}
          loading="lazy"
          class="w-full h-full object-cover object-top"
          style="background:var(--surface-2)"
        />
      ) : (
        <Image
          src={image}
          alt={`${name} — ${tech.slice(0, 2).join(", ")} | Simone Puliti`}
          width={600}
          height={400}
          loading="lazy"
          class="w-full h-full object-cover object-top"
          style="background:var(--surface-2)"
        />
      )}
    </a>
  )}

  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-2xl leading-snug pt-2 px-5 mb-0" style="color:var(--text)">{name}</h3>
    <div class="flex gap-2 shrink-0 pt-2 pr-5">
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover-icon">
          <span class="w-4 h-4 block" set:html={githubIcon} />
        </a>
      )}
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" aria-label="Apri sito" class="hover-icon">
          <span class="w-4 h-4 block" set:html={arrowIcon} />
        </a>
      )}
    </div>
  </div>

  <p class="text-base leading-relaxed flex-1 px-5 py-4" style="color:var(--muted)">{description}</p>

  <div class="flex flex-wrap gap-1.5 p-5 pt-0">
    {tech.map((t) => (
      <span class="text-sm px-2 py-0.5 rounded" style="background:var(--badge-bg);color:var(--badge-text);font-family:var(--font-mono);border:1px solid var(--badge-border)">
        {t}
      </span>
    ))}
  </div>
</article>
