---
const year = new Date().getFullYear();
---

<footer data-template-part="footer" class="mt-16 md:mt-24 px-6 pt-8 pb-10 max-w-6xl mx-auto flex items-center justify-between relative z-10" style="border-top:1px solid var(--border)">
  <p class="text-xs" style="color:var(--muted-2);font-family:var(--font-mono)">© {year} Simone Puliti</p>
  <p class="text-xs" style="color:var(--muted-2);font-family:var(--font-mono)">Astro · Tailwind · Decap CMS</p>
</footer>
