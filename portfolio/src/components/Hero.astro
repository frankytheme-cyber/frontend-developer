---
import arrowIcon from "lucide-static/icons/arrow-up-right.svg?raw";

const TAGLINE =
  "Progetto e sviluppo prodotti digitali ad alte prestazioni. Lavoro con aziende, professionisti e startup — da Verona e in remoto.";

const SERVICES = [
  {
    label: "Web Design & UI/UX",
    description: "Interfacce custom orientate a conversione e brand identity.",
    dot: "#ff5722",
  },
  {
    label: "Siti WordPress & E-commerce",
    description: "Siti vetrina, portali su misura e shop WooCommerce performanti.",
    dot: "#171412",
    href: "/servizi/siti-wordpress-ecommerce",
  },
  {
    label: "Assistenza WordPress",
    description: "Manutenzione, ottimizzazione e supporto continuativo per il tuo sito.",
    dot: "#f59e0b",
    href: "/assistenza-wordpress-verona",
  },
  {
    label: "App React / Next.js",
    description: "Interfacce moderne, dashboard fintech e tool web ad alte prestazioni.",
    dot: "#0ea5e9",
    href: "/servizi/app-react-nextjs",
  },
  {
    label: "Assistenti AI Personalizzati",
    description: "Chatbot e automazioni AI integrate nei tuoi flussi aziendali.",
    dot: "#ec4899",
    href: "/tool-ai-verona",
  },
  {
    label: "SEO & Performance",
    description: "Ottimizzazione tecnica per ranking, velocità e Core Web Vitals.",
    dot: "#10b981",
  },
] as const;
---

<section class="relative min-h-screen flex flex-col justify-center px-6 pb-10 pt-20 md:pb-20 overflow-hidden" data-template-part="hero">
  <!-- Texture animata: nuvole bianche + grain -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0" style="opacity:var(--cloud-opacity)">
      <div
        class="cloud-drift-1 absolute"
        style="top:-20%;left:-15%;width:65vw;height:55vw;background:radial-gradient(ellipse at center, rgba(255,255,255,0.75) 0%, rgba(255,255,255,0.25) 45%, rgba(255,255,255,0) 70%);filter:blur(40px);will-change:transform,opacity"
      />
      <div
        class="cloud-drift-2 absolute"
        style="top:10%;right:-20%;width:60vw;height:50vw;background:radial-gradient(ellipse at center, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 75%);filter:blur(50px);will-change:transform,opacity"
      />
      <div
        class="cloud-drift-3 absolute"
        style="bottom:-25%;left:10%;width:70vw;height:55vw;background:radial-gradient(ellipse at center, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0.18) 50%, rgba(255,255,255,0) 75%);filter:blur(45px);will-change:transform,opacity"
      />
    </div>
    <div class="hero-grain absolute inset-0" style="opacity:0.04;mix-blend-mode:multiply" />
  </div>

  <!-- Contenuto centrato -->
  <div class="relative z-10 w-full mx-auto text-center" style="max-width:1080px">
    <span
      data-reveal
      class="inline-flex items-center mb-8"
      style="--d:0.1s;gap:10px;padding:7px 14px;border-radius:999px;background:var(--badge-bg);border:1px solid var(--border-soft);font-size:11px;font-weight:600;letter-spacing:1.4px;text-transform:uppercase;color:var(--badge-text);font-family:var(--font-mono)"
    >
      <span style="width:6px;height:6px;border-radius:999px;background:var(--accent-2);display:inline-block" />
      Disponibile · Verona / Remote
    </span>

    <h1 data-reveal class="mb-6" style="--d:0.18s;--y:24px;color:var(--text)">
      <span class="block text-[clamp(2rem,5.2vw,4rem)] font-black leading-[0.95] tracking-[-0.03em]">
        Web Designer<br />
        & Sviluppatore Tool AI<br />
        a Verona<span style="color:var(--accent-2)">.</span>
      </span>
      <span class="block mt-5 text-[clamp(1rem,2vw,1.35rem)] font-semibold tracking-tight" style="color:var(--muted)">
        Simone Puliti
      </span>
    </h1>

    <h2
      data-reveal
      class="text-base font-semibold tracking-[0.12em] uppercase mb-8"
      style="--d:0.26s;--y:10px;color:var(--muted);font-family:var(--font-mono)"
    >
      Siti WordPress · E-commerce WooCommerce · App React/Next.js · Tool AI personalizzati
    </h2>

    <p data-reveal class="text-lg font-normal leading-relaxed" style="--d:0.35s;--y:10px;color:var(--muted);margin:0 auto 32px;max-width:640px">
      {TAGLINE}
    </p>

    <div data-reveal class="flex flex-wrap justify-center mb-16" style="--d:0.5s;--y:8px;gap:14px">
      <a
        href="/contatti"
        class="hover-opacity inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold transition-all duration-200"
        style="background:#171412;color:#fff;border-radius:2px;border:1px solid #2a2724"
      >
        Parliamo del tuo progetto
        <span class="w-4 h-4" set:html={arrowIcon} />
      </a>
      <a
        href="/progetti/siti-web"
        class="hover-text-and-border inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold transition-all duration-200"
        style="border:1px solid var(--border);color:var(--muted);border-radius:2px"
      >
        Scopri i miei progetti
      </a>
    </div>

    <div data-reveal style="--d:0.7s" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {SERVICES.map(({ label, description, dot, href }, i) => {
        const Tag = href ? "a" : "div";
        return (
          <Tag
            href={href}
            data-reveal
            class={`hover-border-accent group flex flex-col p-5 text-left ${href ? "cursor-pointer" : "cursor-default"}`}
            style={`--d:${(0.8 + i * 0.06).toFixed(2)}s;background:var(--surface);border:1px solid var(--border);border-radius:12px`}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <span class="text-xs" style="color:var(--muted-2);font-family:var(--font-mono)">{i + 1}.</span>
                <h3 class="text-base font-bold leading-tight mt-1 tracking-tight" style="color:var(--text)">{label}</h3>
              </div>
              <span class="rounded-full shrink-0" style={`width:12px;height:12px;background:${dot};margin-top:4px`} aria-hidden="true" />
            </div>
            <div class="h-px my-4" style="background:var(--border)" />
            <p class="text-sm leading-relaxed" style="color:var(--muted)">{description}</p>
          </Tag>
        );
      })}
    </div>
  </div>
</section>
