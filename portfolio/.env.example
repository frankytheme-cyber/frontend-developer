# ── Form contatti ────────────────────────────────────────────────
# Chiave API di Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Indirizzo su cui ricevi i messaggi del form
CONTACT_TO_EMAIL=simowebdesigner@gmail.com
# Mittente: il dominio dev'essere verificato su Resend
CONTACT_FROM_EMAIL="Sito Simone Puliti <noreply@simonepuliti.dev>"

# ── Anti-spam: Cloudflare Turnstile (opzionale) ──────────────────
# Chiavi gratuite su https://dash.cloudflare.com → Turnstile.
# Senza queste variabili il widget non compare e il form resta protetto da
# honeypot, time-trap, rate limit e filtro contenuti.
# Il prefisso PUBLIC_ è richiesto da Astro per esporre la variabile al browser.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Decap CMS — OAuth provider GitHub (vedi README) ──────────────
# Creata su GitHub → Settings → Developer settings → OAuth Apps.
# Authorization callback URL: https://<dominio-produzione>/api/callback
GITHUB_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
